<section class="section section--tight">
  <div class="page-width">
    <div class="features">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <strong>{{ block.settings.title }}</strong>
            <span>{{ block.settings.text }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "return", "label": "Returns" },
            { "value": "headset", "label": "Headset" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Δωρεάν αποστολή" },
        { "type": "text", "id": "text", "label": "Text", "default": "Άνω των 60€" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "truck", "title": "Δωρεάν αποστολή", "text": "Άνω των 60€" } },
        { "type": "feature", "settings": { "icon": "bolt", "title": "Αποστολή 24h", "text": "Για παραγγελίες έως 15:00" } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Εγγύηση 2 ετών", "text": "Επίσημος αντιπρόσωπος" } },
        { "type": "feature", "settings": { "icon": "return", "title": "Επιστροφή 14 ημερών", "text": "Χωρίς ερωτήσεις" } }
      ]
    }
  ]
}
{% endschema %}
