{%- if section.settings.show_bar -%}
  <div class="announcement">
    <div class="announcement__track">
      {%- for block in section.blocks -%}
        <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show bar", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Δωρεάν αποστολή άνω των 60€" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Δωρεάν αποστολή άνω των 60€" } },
        { "type": "message", "settings": { "text": "Εγγύηση 2 ετών σε όλα τα προϊόντα" } },
        { "type": "message", "settings": { "text": "Παράδοση 1–3 εργάσιμες" } }
      ]
    }
  ]
}
{% endschema %}
