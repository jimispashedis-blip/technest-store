{%- comment -%}
  Usage: {% render 'price', product: product, size: 'lg' %}
{%- endcomment -%}
{%- liquid
  assign compare = product.compare_at_price_max
  assign current = product.price_min
  assign on_sale = false
  if compare > current
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% if size == 'lg' %} price--lg{% endif %}">
  <span class="price__current">
    {%- if product.price_varies -%}
      {{- 'products.product.from' | t | default: 'Από' }} {{ current | money -}}
    {%- else -%}
      {{- current | money -}}
    {%- endif -%}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">{{ compare | money }}</s>
  {%- endif -%}
</div>
