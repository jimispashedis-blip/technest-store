<div class="page-width section page-narrow" style="max-width:520px;">
  <p class="section__eyebrow">{{ shop.name }}</p>
  <h1>{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="form-field">
      <label for="RegFirst">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" name="customer[first_name]" id="RegFirst" autocomplete="given-name">
    </div>
    <div class="form-field">
      <label for="RegLast">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" name="customer[last_name]" id="RegLast" autocomplete="family-name">
    </div>
    <div class="form-field">
      <label for="RegEmail">Email</label>
      <input type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
    </div>
    <div class="form-field">
      <label for="RegPassword">{{ 'customer.login.password' | t }}</label>
      <input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
    </div>

    <button class="btn btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}

  <p style="margin-top:1.25rem;"><a href="{{ routes.account_login_url }}">Έχεις ήδη λογαριασμό; Σύνδεση</a></p>
</div>
